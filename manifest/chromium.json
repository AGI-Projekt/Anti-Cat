{
  "manifest_version": 3,
  "name": "Cat — Kitty Edition",
  "version": "1.0.0",
  "description": "Filtrowanie domen i obsługiwanego podzbioru reguł sieciowych Adblock Plus, z walidacją i rollbackiem.",
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "activeTab",
    "alarms"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Cat — Kitty Edition",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/cat-16.png",
      "32": "icons/cat-32.png",
      "48": "icons/cat-48.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/cat-16.png",
    "32": "icons/cat-32.png",
    "48": "icons/cat-48.png",
    "128": "icons/cat-128.png"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "cat_ads",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "detector.js",
        "cleaner.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "optional_host_permissions": [
    "https://*/*"
  ]
}

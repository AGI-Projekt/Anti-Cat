{
  "manifest_version": 3,
  "name": "Cat — Kitty Edition",
  "version": "1.0.0",
  "description": "Ostrożne filtrowanie wybranych reklam i porządkowanie stron.",
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "activeTab"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Cat — Kitty Edition",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "cat_ads",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "detector.js",
        "cleaner.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "optional_host_permissions": [
    "https://*/*"
  ]
}
